# Clip-Fabrik – GPU-Variante (NVIDIA): Whisper auf CUDA (float16), NVENC fürs Rendern wenn verfügbar.
FROM node:22-bookworm-slim AS frontend
WORKDIR /src
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    DATA_DIR=/data FRONTEND_DIST=/app/frontend/dist HF_HOME=/data/models TZ=Europe/Berlin \
    WHISPER_DEVICE=cuda WHISPER_COMPUTE_TYPE=float16 NVIDIA_DRIVER_CAPABILITIES=compute,utility,video
RUN apt-get update \
 && apt-get install -y --no-install-recommends software-properties-common \
 && add-apt-repository -y ppa:deadsnakes/ppa \
 && apt-get update && apt-get install -y --no-install-recommends python3.12 python3.12-venv ffmpeg fonts-dejavu-core tini curl ca-certificates tzdata \
 && python3.12 -m venv /opt/venv && rm -rf /var/lib/apt/lists/*
ENV PATH=/opt/venv/bin:$PATH
WORKDIR /app/backend
COPY backend/requirements.txt ./
RUN pip install -r requirements.txt
COPY backend/ ./
RUN pip install --no-deps -e .
COPY --from=frontend /src/dist /app/frontend/dist
RUN useradd -m -u 1000 clip && mkdir -p /data && chown -R clip /data
USER clip
VOLUME ["/data"]
EXPOSE 8000
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["clipfabrik", "worker"]
