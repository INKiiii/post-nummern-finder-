# ============================================================================
# Clip-Fabrik – Konfiguration. Kopieren nach .env (das Einrichtungsskript macht das automatisch).
# Alles mit „(Settings)“ kann auch später in der App unter Einstellungen geändert werden.
# Secrets werden in der App verschlüsselt gespeichert und nie ins Log geschrieben.
# ============================================================================

# --- Pflicht -----------------------------------------------------------------
# Adresse, unter der die App erreichbar ist. Ohne eigene Domain: <IP-mit-Bindestrichen>.sslip.io
DOMAIN=203-0-113-7.sslip.io
PUBLIC_URL=https://203-0-113-7.sslip.io
# Zufälliger, langer Schlüssel (verschlüsselt Secrets und signiert Logins). NIE ändern, sonst sind gespeicherte Keys weg.
SECRET_KEY=bitte-durch-zufallswert-ersetzen
# Passwort für die App (nur beim ersten Start übernommen, danach in der App änderbar)
ADMIN_PASSWORD=bitte-ein-langes-passwort-setzen

# --- KI ------------------------------------------------------------------------
# Anthropic-API-Key (Settings). Ohne Key läuft ein deutlich schwächerer Heuristik-Modus.
ANTHROPIC_API_KEY=
# Whisper-Modelle: medium für Nachbearbeitung, small für Live (CPU). Mit GPU: large-v3 / medium.
WHISPER_MODEL=medium
WHISPER_LIVE_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# --- Twitch (Settings) ----------------------------------------------------------
# dev.twitch.tv/console/apps → Anwendung registrieren, Redirect-URL: https://<DOMAIN>/api/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Segmentlänge der Aufnahme in Sekunden
SEGMENT_SECONDS=120

# --- Push-Fallbacks (Settings) ----------------------------------------------------
VAPID_SUBJECT=mailto:admin@example.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_URL=

# --- Plattformen (siehe README → API-Freigaben) ------------------------------------
# TikTok for Developers: Content Posting API, Redirect: https://<DOMAIN>/api/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Meta for Developers: Instagram API mit Instagram-Login, Redirect: https://<DOMAIN>/api/oauth/instagram/callback
META_APP_ID=
META_APP_SECRET=
# Google Cloud: YouTube Data API v3, OAuth-Client „Webanwendung“, Redirect: https://<DOMAIN>/api/oauth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional -----------------------------------------------------------------------
# Cloudflare Tunnel statt offener Ports (docker compose --profile tunnel up -d)
TUNNEL_TOKEN=
# Parallele Worker (CPU: 1, GPU: 2)
WORKER_CONCURRENCY=1
LOG_LEVEL=INFO
TZ=Europe/Berlin
