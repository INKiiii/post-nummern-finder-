{
  "name": "hausnummern-finder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Offline-PWA für Zusteller: Hausnummern schnell finden, mit Haus-Infos zu Eingängen und Briefkästen.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "build-regions": "node --max-old-space-size=6144 scripts/build-regions.mjs",
    "report": "node scripts/report.mjs",
    "sample-test": "node scripts/sample-test.mjs",
    "demo-data": "node scripts/make-demo-data.mjs",
    "test:browser": "node tests/browser/drive.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "fake-indexeddb": "^6.2.5",
    "playwright": "1.56.1",
    "typescript": "~5.9",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
